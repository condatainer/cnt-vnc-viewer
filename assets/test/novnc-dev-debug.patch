+// EXPERIMENT: Chromium >= 149 has a regression where MemoryCache holds
+// strong references to data: URL resources - since a VNC stream
+// continuously generates unique, one-shot data: JPEG URLs, this causes
+// unbounded "Image Cache" / memory growth over a session
+// (https://issues.chromium.org/issues/545977878, novnc/noVNC#2075).
+// Blob + createImageBitmap avoids that retention entirely, but JPEG
+// decode through it has been reported (novnc/noVNC#2075, not
+// independently verified here) as ~8x slower than the data: URI + Image
+// path - a real regression for unaffected browsers/versions if true. So:
+// only pay that cost on browsers actually affected by the Chromium bug,
+// decided once at startup.
+function detectChromiumMemoryCacheBug() {
+    try {
+        const brands = navigator.userAgentData && navigator.userAgentData.brands;
+        if (brands) {
+            for (const b of brands) {
+                if (/Chromium|Google Chrome|Microsoft Edge/.test(b.brand)) {
+                    return parseInt(b.version, 10) >= 149;
+                }
+            }
+            return false;
+        }
+    } catch (e) {
+        // Fall through to legacy UA parsing below.
+    }
+
+    const m = /Chrom(?:e|ium)\/(\d+)/.exec(navigator.userAgent);
+    return !!m && parseInt(m[1], 10) >= 149;
+}
+
