+
+        // EXPERIMENT: debug stats overlay, matching cnt-vnc-viewer's
+        // ?debug=1 overlay (rects/s, jpeg KB/s, render queue depth, JS
+        // heap), for direct A/B comparison. Not part of stock noVNC.
+        if (new URLSearchParams(location.search).get('debug') === '1') {
+            const overlay = document.createElement('div');
+            overlay.style.cssText =
+                'position:fixed;top:4px;left:4px;z-index:99999;' +
+                'background:rgba(0,0,0,0.75);color:#0f0;' +
+                'font:12px monospace;padding:6px 10px;border-radius:4px;' +
+                'white-space:pre;pointer-events:none;';
+            document.body.appendChild(overlay);
+
+            let lastRects = 0, lastBytes = 0, lastT = performance.now();
+            let lastBitmapCount = 0, lastBitmapMs = 0;
+            let lastImgCount = 0, lastImgMs = 0;
+
+            const windowAvg = (count, ms, lastCount, lastMs) => {
+                const n = count - lastCount;
+                return n > 0 ? ((ms - lastMs) / n).toFixed(2) : '-';
+            };
+
+            setInterval(() => {
+                const rfb = UI.rfb;
+                if (!rfb || !rfb._display) return;
+                const d = rfb._display;
+                const now = performance.now();
+                const dt = (now - lastT) / 1000;
+                const rects = d.debugStats.rects;
+                const bytes = d.debugStats.bytes;
+                const rectsPerSec = dt > 0 ? Math.round((rects - lastRects) / dt) : 0;
+                const kbPerSec = dt > 0 ? Math.round((bytes - lastBytes) / dt / 1024) : 0;
+                lastRects = rects;
+                lastBytes = bytes;
+                lastT = now;
+
+                const bc = d.decodeStats.bitmap.count, bm = d.decodeStats.bitmap.totalMs;
+                const ic = d.decodeStats.img.count, im = d.decodeStats.img.totalMs;
+                const avgBitmapMs = windowAvg(bc, bm, lastBitmapCount, lastBitmapMs);
+                const avgImgMs = windowAvg(ic, im, lastImgCount, lastImgMs);
+                lastBitmapCount = bc; lastBitmapMs = bm;
+                lastImgCount = ic; lastImgMs = im;
+
+                const heap = performance.memory
+                    ? Math.round(performance.memory.usedJSHeapSize / 1024 / 1024) + 'MB'
+                    : 'n/a';
+
