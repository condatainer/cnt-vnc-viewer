+// 'bitmap' or 'img' before the RFB/Display is constructed to force a
+// path regardless of browser detection - needed to A/B the two paths
+// (e.g. measure decode latency) on the same machine/browser rather than
+// relying on whichever real Chromium version happens to be installed.
+const USE_IMAGEBITMAP_DECODE =
+    (typeof window !== 'undefined' && window.__NOVNC_FORCE_DECODE)
+        ? window.__NOVNC_FORCE_DECODE === 'bitmap'
+        : detectChromiumMemoryCacheBug();
